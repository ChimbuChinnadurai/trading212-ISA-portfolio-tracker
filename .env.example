# Copy this file to .env for local development (never commit .env)
# ─────────────────────────────────────────────────────────────────────────────

# Trading212 API key — generate from Settings > API (Beta) in your account
TRADING212_API_KEY=API_KEY

# Base URL — use https://live.trading212.com for real ISA or
#            https://demo.trading212.com for paper trading
TRADING212_BASE_URL=https://live.trading212.com

# Massive API key — for upcoming dividend data (US stocks)
MASSIVE_API_KEY=your_massive_api_key

# Finnhub API key — for earnings calendar and market news
FINNHUB_TOKEN=your_finnhub_token

# Port (Cloud Run injects this automatically)
PORT=8080
